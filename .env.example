# Copy this file to .env and adjust values as needed.
# docker-compose.yml sets these directly; .env is used for local development.

# ── Model backend ──────────────────────────────────────────────────────────────
# Leave TRANSLATION_MODEL empty to use Helsinki-NLP OPUS-MT (one model per pair).
# Set to an NLLB model to use a single multilingual model for all pairs:
#   facebook/nllb-200-distilled-600M   ~2.4 GB RAM, good quality
#   facebook/nllb-200-distilled-1.3B   ~5 GB RAM, higher quality
TRANSLATION_MODEL=

# If TRANSLATION_MODEL fails to load, the service falls back to OPUS-MT
# auto-detection (Helsinki-NLP/opus-mt-{src}-{tgt}). Set this to document
# the intended fallback — it does not change the auto-detection logic.
FALLBACK_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-{src}-{tgt}

# ── Request limits ─────────────────────────────────────────────────────────────
MAX_CHARS_PER_REQUEST=10000

# Max characters per internal chunk fed to the model tokenizer.
# OPUS-MT: 512-token limit → 450 chars safe.
# NLLB: recommend ≤ 400 chars (~250 tokens) per model card.
CHUNK_SIZE=450

# ── Logging / CORS ─────────────────────────────────────────────────────────────
# Set to true only for debugging — translated text will appear in logs.
LOG_TEXT=false

# Comma-separated list of allowed origins, or * to allow all.
ALLOWED_ORIGINS=*
