# Copy this file to .env and adjust values as needed.
# docker-compose.yml sets these directly; .env is used for local development.

MAX_CHARS_PER_REQUEST=10000

# Max characters per internal chunk fed to the model tokenizer.
# OPUS-MT models have a 512-token limit; 450 chars is safe for SK/FR/EN.
CHUNK_SIZE=450

# Set to true only for debugging — translated text will appear in logs.
LOG_TEXT=false

# Comma-separated list of allowed origins, or * to allow all.
ALLOWED_ORIGINS=*
